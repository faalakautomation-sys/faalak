{
  "name": "faalak",
  "main": "./worker.js",
  "compatibility_date": "2026-10-18",
  "routes": [
    { "pattern": "faalak.com/*", "zone_name": "faalak.com" },
    { "pattern": "www.faalak.com/*", "zone_name": "faalak.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Prerender writes dist/<route>/index.html. drop-trailing-slash serves the
    // slashless URL with 200 and redirects the slash variant to it.
    // 404-page serves dist/404.html with HTTP 404. Do not switch this back to
    // single-page-application: unknown URLs would soft-200 as the homepage.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*"]
  }
}
